{
  "schema_version": "0.1-draft",
  "project": {"id": "sample.generic", "display_name": "Neutrales Beispielprojekt"},
  "dependencies": [
    {"type": "core.command_action", "version": "1.0.0"},
    {"type": "core.host_handler", "version": "1.0.0"}
  ],
  "components": [
    {"id": "action.primary", "type": "core.command_action", "version": "1.0.0", "config": {"display_name": "Aktion 1"}},
    {"id": "handler.primary", "type": "core.host_handler", "version": "1.0.0", "config": {"callback_id": "handler.primary"}}
  ],
  "states": [
    {
      "id": "state.primary",
      "value_schema": {"type": "string", "enum": ["variant_0", "variant_1"]},
      "authority": {"role": "host"},
      "scope": "project",
      "persistence": "external",
      "fallback": "variant_0"
    }
  ],
  "bindings": [
    {"id": "binding.command", "source": {"owner_kind": "component", "owner_id": "action.primary", "port": "activated"}, "target": {"owner_kind": "component", "owner_id": "handler.primary", "port": "invoke"}, "kind": "command"},
    {"id": "binding.visual_state", "source": {"owner_kind": "state", "owner_id": "state.primary", "port": "value"}, "target": {"owner_kind": "presentation", "owner_id": "visual.primary", "port": "selector"}, "kind": "state"}
  ],
  "presentations": [
    {"id": "visual.primary", "variants": {"variant_0": {"text": "Variante 0", "background": "#424242"}, "variant_1": {"text": "Variante 1", "background": "#2E7D32"}}}
  ],
  "assets": [],
  "views": [
    {"id": "view.main", "type": "folder", "placements": [{"id": "placement.main", "component": "action.primary", "presentation": "visual.primary", "position": 0}]},
    {"id": "view.secondary", "type": "folder", "placements": [{"id": "placement.secondary", "component": "action.primary", "presentation": "visual.primary", "position": 2}]}
  ]
}

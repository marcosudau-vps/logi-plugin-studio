{
  "schema_version": "0.1-draft",
  "project": {"id": "studio.first.plugin", "display_name": "Mein erstes Python-Plugin"},
  "dependencies": [
    {"type": "core.command_action", "version": "1.0.0"},
    {"type": "core.host_handler", "version": "1.0.0"}
  ],
  "components": [
    {"id": "action.first", "type": "core.command_action", "version": "1.0.0", "config": {"display_name": "Meine erste Aktion"}},
    {"id": "action.second", "type": "core.command_action", "version": "1.0.0", "config": {"display_name": "Meine zweite Aktion"}},
    {"id": "handler.toggle", "type": "core.host_handler", "version": "1.0.0", "config": {"callback_id": "toggle"}}
  ],
  "states": [
    {"id": "state.mode", "value_schema": {"type": "string", "enum": ["active", "idle"]}, "authority": {"role": "host"}, "scope": "component", "persistence": "none", "fallback": "idle"}
  ],
  "bindings": [
    {"id": "binding.first", "kind": "command", "source": {"owner_kind": "component", "owner_id": "action.first", "port": "activated"}, "target": {"owner_kind": "component", "owner_id": "handler.toggle", "port": "invoke"}},
    {"id": "binding.second", "kind": "command", "source": {"owner_kind": "component", "owner_id": "action.second", "port": "activated"}, "target": {"owner_kind": "component", "owner_id": "handler.toggle", "port": "invoke"}},
    {"id": "binding.visual", "kind": "state", "source": {"owner_kind": "state", "owner_id": "state.mode", "port": "value"}, "target": {"owner_kind": "presentation", "owner_id": "visual.mode", "port": "selector"}}
  ],
  "presentations": [
    {"id": "visual.mode", "variants": {"idle": {"text": "Bereit", "background": "#243449", "foreground": "#ffffff"}, "active": {"text": "Aktiv", "background": "#25684a", "foreground": "#ffffff"}}}
  ],
  "assets": [],
  "views": [
    {"id": "view.main", "type": "folder", "placements": [
      {"id": "placement.first", "component": "action.first", "presentation": "visual.mode", "position": 0},
      {"id": "placement.second", "component": "action.second", "presentation": "visual.mode", "position": 1}
    ]},
    {"id": "view.more", "type": "folder", "placements": [
      {"id": "placement.more.1", "component": "action.first", "presentation": "visual.mode", "position": 0},
      {"id": "placement.more.2", "component": "action.second", "presentation": "visual.mode", "position": 1},
      {"id": "placement.more.3", "component": "action.first", "presentation": "visual.mode", "position": 2},
      {"id": "placement.more.4", "component": "action.second", "presentation": "visual.mode", "position": 3},
      {"id": "placement.more.5", "component": "action.first", "presentation": "visual.mode", "position": 4},
      {"id": "placement.more.6", "component": "action.second", "presentation": "visual.mode", "position": 5},
      {"id": "placement.more.7", "component": "action.first", "presentation": "visual.mode", "position": 6},
      {"id": "placement.more.8", "component": "action.second", "presentation": "visual.mode", "position": 7},
      {"id": "placement.more.9", "component": "action.first", "presentation": "visual.mode", "position": 8},
      {"id": "placement.more.10", "component": "action.second", "presentation": "visual.mode", "position": 9}
    ]}
  ]
}
